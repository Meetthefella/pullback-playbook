{
  "name": "pullback-playbook",
  "version": "4.5.2",
  "private": true,
  "scripts": {
    "debug:compare-review-snapshots": "node scripts/compare-review-snapshots.js",
    "debug:compare-review-snapshot": "node scripts/compare-review-snapshot.js",
    "debug:near-entry-shortlist": "node scripts/debug-near-entry-shortlist.js",
    "debug:market-snapshot": "node scripts/debug-market-snapshot.js",
    "test:ui:parity": "node scripts/run-playwright-fresh-port.js test tests/ui",
    "test:ui:all": "node scripts/run-ui-suite.js all",
    "test:ui:ci": "node scripts/run-ui-suite.js ci",
    "test:ui:smoke": "node scripts/run-playwright-fresh-port.js test tests/ui/smoke",
    "test:ui:file-contracts": "playwright test --config=playwright.file-contracts.config.js",
    "test:ui:track-contract": "playwright test --config=playwright.file-contracts.config.js tests/ui/contracts/track-state-presentation-contract.spec.js --reporter=list --workers=1 --trace=off",
    "test:ui:contracts": "playwright test --config=playwright.file-contracts.config.js",
    "test:ui:regressions": "node scripts/run-playwright-fresh-port.js test tests/ui/regressions",
    "test:ui:journeys": "node scripts/run-playwright-fresh-port.js test tests/ui/journeys",
    "test:ui:journeys:multi": "node scripts/run-playwright-fresh-port.js test \"tests/ui/journeys/specified-ticker-journey.spec.js\" --workers 1 --trace on",

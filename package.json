    "test:unit": "node tests/unit/run-unit-suite.js all",
    "test:unit:resolver": "node tests/unit/run-unit-suite.js resolver",
    "test:unit:contracts": "node tests/unit/run-unit-suite.js contracts",
    "test:unit:chart-guru-ai": "node scripts/run-chart-guru-ai-contract-assertions.js",
    "test:unit:chart-guru-narration": "node scripts/run-chart-guru-narration-contract-assertions.js",
    "test:unit:pullback-authority": "node tests/unit/run-unit-suite.js pullback-authority",
    "test:unit:persistence": "node tests/unit/run-unit-suite.js persistence",
    "test:unit:execution": "node tests/unit/run-unit-suite.js execution",
    "test:tester-bundle-admin": "node scripts/run-tester-bundle-admin-tests.js",
    "test:tester-bundle": "node scripts/run-tester-bundle-handler-tests.js",
    "test:tester-bundle-fetch": "node scripts/run-fetch-tester-bundle-tests.js",
    "test:tester-bundle-receipts": "node scripts/run-tester-bundle-receipts-tests.js",
    "test:tester-bundle-status": "node scripts/run-tester-bundle-status-tests.js",
    "test:chart-guru:ai": "node scripts/run-chart-guru-openai-harness.js",
    "test:storage-persistence": "node scripts/run-storage-persistence-assertions.js",
    "test:resolver-gates": "node scripts/run-resolver-gate-assertions.js",
    "test:canonical-decision-baseline": "node scripts/run-canonical-decision-baseline-assertions.js",
    "test:canonical-norm": "node scripts/run-canonical-norm-assertions.js",
    "test:trade-execution": "node scripts/run-trade-execution-handler-tests.js"
